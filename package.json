{
  "name": "zaenal-wahyudin-portfolio",
  "version": "2.0.0",
  "description": "Modern portfolio website for Zaenal Wahyudin - Web Developer & UI Designer",
  "main": "index.html",
  "scripts": {
    "start": "npx live-server --port=3000 --open=/",
    "dev": "npx live-server --port=3000 --open=/ --watch=css,js",
    "build": "echo 'No build process needed for static site'",
    "deploy": "gh-pages -d .",
    "lint:css": "npx stylelint css/*.css",
    "lint:js": "npx eslint js/*.js",
    "optimize:images": "npx imagemin images/* --out-dir=images/optimized",
    "test": "echo 'No tests specified'",
    "validate:html": "npx html-validate index.html",
    "lighthouse": "npx lighthouse https://zaenalwahyudin.github.io/portfolio/ --output=html --output-path=./lighthouse-report.html"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zaenalwahyudin/portfolio.git"
  },
  "keywords": [
    "portfolio",
    "web-developer",
    "ui-designer",
    "frontend",
    "javascript",
    "html",
    "css",
    "responsive",
    "modern"
  ],
  "author": {
    "name": "Zaenal Wahyudin",
    "email": "zaenalwahyudin@example.com",
    "url": "https://zaenalwahyudin.github.io/portfolio/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zaenalwahyudin/portfolio/issues"
  },
  "homepage": "https://zaenalwahyudin.github.io/portfolio/",
  "devDependencies": {
    "live-server": "^1.2.2",
    "gh-pages": "^4.0.0",
    "stylelint": "^15.0.0",
    "eslint": "^8.0.0",
    "imagemin": "^8.0.1",
    "html-validate": "^7.0.0",
    "lighthouse": "^10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}